{
  "name": "@nimoguard/policy",
  "version": "0.1.0",
  "description": "NimoGuard policy engine: a pure, default-deny authorize() function that fails closed.",
  "license": "MIT",
  "author": "Nima Hamdi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimaohamdi/NimoGuard.git",
    "directory": "packages/policy"
  },
  "homepage": "https://github.com/nimaohamdi/NimoGuard#readme",
  "bugs": {
    "url": "https://github.com/nimaohamdi/NimoGuard/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/**/*.test.js",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@nimoguard/core": "workspace:*",
    "@nimoguard/capabilities": "workspace:*"
  }
}
