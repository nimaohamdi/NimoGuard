{
  "name": "@nimoguard/core",
  "version": "0.1.0",
  "description": "Shared types for NimoGuard: actions, decisions, capabilities and authorization requests.",
  "license": "MIT",
  "author": "Nima Hamdi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimaohamdi/NimoGuard.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nimaohamdi/NimoGuard#readme",
  "bugs": {
    "url": "https://github.com/nimaohamdi/NimoGuard/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  }
}
